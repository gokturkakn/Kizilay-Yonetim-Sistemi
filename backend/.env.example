# Örnek ortam dosyası — bu dosya depoya girer, gerçek .env GİRMEZ.
# Kullanım: cp .env.example .env  ve değerleri doldurun.

PORT=4141

# ---------------------------------------------------------------------------
# ORTAM TÜRÜ
# ---------------------------------------------------------------------------
# Sistem şu üç koşuldan biri sağlanıyorsa "üretim benzeri" sayılır ve aşağıdaki
# güvenlik kontrolleri devreye girer:
#   NODE_ENV=production   |   RENDER=<herhangi bir değer>   |   KK_ENV=production
# Kaçış kapısı (yerelde üretim davranışını denemek/geri almak için):
#   KK_ENV=development    → her zaman geliştirme sayılır
# KK_ENV=

# ---------------------------------------------------------------------------
# JWT İMZA ANAHTARI  (üretim benzeri ortamda ZORUNLU — yoksa sunucu AÇILMAZ)
# ---------------------------------------------------------------------------
# En az 32 karakter. Geliştirme varsayılanına eşit olamaz (o değer depoda açıktır).
# Üretmek için:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
KK_JWT_SECRET=

# ---------------------------------------------------------------------------
# İLK YÖNETİCİ HESABI
# ---------------------------------------------------------------------------
# Üretim benzeri ortamda bilinen şifreli varsayılan hesap OLUŞTURULMAZ. İlk
# yöneticiyi bir kez bu değişkenlerle başlatarak açın, sonra değişkenleri KALDIRIN.
# Hesap "şifre değişikliği zorunlu" bayrağıyla açılır: ilk girişten sonra
# POST /auth/change-password çağrılmadan başka hiçbir uç kullanılamaz.
# KK_SEED_ADMIN_EMAIL=yonetici@kizilay.org.tr
# KK_SEED_ADMIN_PASSWORD=      # en az 8 karakter, harf + rakam
# KK_SEED_ADMIN_NAME=Genel Merkez Yöneticisi

# ---------------------------------------------------------------------------
# GİRİŞ HIZ SINIRLAMA (kaba kuvvet koruması) — hepsi opsiyonel
# ---------------------------------------------------------------------------
# KK_LOGIN_MAX_ATTEMPTS=5          # hesap başına başarısız deneme sınırı
# KK_LOGIN_IP_MAX_ATTEMPTS=20      # IP başına başarısız deneme sınırı
# KK_LOGIN_WINDOW_MS=900000        # sayma penceresi (15 dk)
# KK_LOGIN_LOCK_MS=900000          # kilit süresi (15 dk)
# Vekil sunucu arkasındaysanız gerçek istemci IP'si X-Forwarded-For'dan okunur.
# Üretim benzeri ortamda otomatik açıktır; yerelde açmak için:
# KK_TRUST_PROXY=1

# ---------------------------------------------------------------------------
# DİĞER
# ---------------------------------------------------------------------------
# SQLite yolu (varsayılan: backend/data/app.db)
# KK_DB_PATH=

# Yüklenen dosyaların dizini (varsayılan: backend/uploads)
# KK_UPLOAD_DIR=

# Demo (sahte) kayıtları yükler — ÜRETİMDE ASLA AYARLAMAYIN.
# KK_SEED_DEMO=1

# Postgres'e taşındıysanız bağlantı adresi. Parola içerir — asla paylaşmayın.
# DATABASE_URL=postgresql://kullanici:parola@sunucu/veritabani?sslmode=require
